        "lsp_references": {
          "eager": false
        },
        "lsp_code_actions": {
          "eager": false
        },
        "git_bisect_auto": {
          "eager": false
        },
        "ram_graph_query": {
          "eager": false
        },
        "mutation_guard_check": {
          "eager": false
